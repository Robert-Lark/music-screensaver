#!/bin/bash
# Every check, stopping at the first that fails.
#
#   scripts/check            static checks, then the build with warnings as errors
#   scripts/check --static   static checks only (seconds; the pre-commit hook)
#
# Static: shellcheck, ruff (real errors only: the scripts are one-off collection tools), qmllint,
# the guards (file size, qmllint warnings) and the canary. The build goes to a temporary folder,
# never to build/, which the installed launcher runs.
#
# guards-allowlist.json holds what broke a guard when the guards landed. It only shrinks: no new
# entry or higher count than origin/main has, and a fixed entry goes in the change that fixed it.
set -euo pipefail
cd "$(dirname "$0")/.."

MAX_TOKENS=5500
CXXFLAGS_STRICT=(-Wall -Wextra -Werror)
RUFF=(uvx --quiet ruff@0.17.0 check --isolated --select "F,E9,B" --line-length 100)
QMLLINT=$(command -v qmllint6 || command -v qmllint || echo /usr/lib/qt6/bin/qmllint)
SHELLCHECK=$(command -v shellcheck || mise which shellcheck)
# What the checks cover, found the same way the size guard finds files, so a new file is checked
# from its first commit. canary/ holds the planted violations and is checked by the canary only.
SIZE_FOLDERS=(app bin scripts)

step() { printf '== %s\n' "$1"; }
fail() { printf 'The %s check failed: %s\n' "$1" "$2" >&2; exit 1; }

# How many warnings qmllint gives a QML file.
qml_warnings() { "$QMLLINT" "$1" 2>&1 | grep -c '^Warning:' || true; }

# Compile one C++ file with the strict flags (the canary's stand-in for the build).
strict_compile() { g++ "${CXXFLAGS_STRICT[@]}" -std=c++17 -fsyntax-only "$1"; }

# Tracked and new files, existing ones only (a deleted file is still listed until it is staged).
listed() { local f; while IFS= read -r f; do [[ -f $f ]] && printf '%s\n' "$f"; done < <(git ls-files --cached --others --exclude-standard "$@"); }
qml_files() { listed '*.qml' | grep -v '^canary/'; }
python_files() { listed '*.py' | grep -v '^canary/'; }
# Shell scripts: *.sh, and any file whose first line runs bash or sh.
shell_files() {
  local f
  while IFS= read -r f; do
    [[ $f == canary/* ]] && continue
    if [[ $f == *.sh ]] || head -n1 "$f" | grep -qE '^#!.*\b(ba)?sh\b'; then printf '%s\n' "$f"; fi
  done < <(listed)
}

allowed() { jq -r "$1 // 0" guards-allowlist.json; }
MAIN_ALLOWLIST=$(git show origin/main:guards-allowlist.json 2>/dev/null || true)
# main's count for a key, or nothing when main has no allowlist yet (the guards are landing).
allowed_on_main() { [[ -n $MAIN_ALLOWLIST ]] && jq -r "$1 // 0" <<< "$MAIN_ALLOWLIST"; }
excused_for_size() { jq -e --arg f "$1" '.oversizeFiles | index($f) != null' guards-allowlist.json >/dev/null; }

# The size guard over the files given, one per line on stdin.
size_problems() {
  local file tokens problems=0
  while IFS= read -r file; do
    tokens=$(( $(wc -c < "$file") / 4 ))
    if (( tokens > MAX_TOKENS )) && ! excused_for_size "$file"; then
      echo "  $file: $tokens tokens, over the $MAX_TOKENS-token limit. Split it." >&2
      problems=1
    elif (( tokens <= MAX_TOKENS )) && excused_for_size "$file"; then
      echo "  $file: now under the size limit. Remove it from oversizeFiles." >&2
      problems=1
    fi
  done
  return "$problems"
}

guard_sizes() {
  local file problems=0
  size_problems < <(listed "${SIZE_FOLDERS[@]}") || problems=1
  while IFS= read -r file; do
    [[ -z $file ]] && continue
    if [[ ! -f $file ]]; then echo "  $file: in oversizeFiles but gone. Remove it." >&2; problems=1; fi
    if [[ -n $MAIN_ALLOWLIST ]] && ! jq -e --arg f "$file" '.oversizeFiles | index($f) != null' <<< "$MAIN_ALLOWLIST" >/dev/null; then
      echo "  $file: added to oversizeFiles. The allowlist only shrinks: split the file." >&2; problems=1
    fi
  done < <(jq -r '.oversizeFiles[]' guards-allowlist.json)
  return "$problems"
}

guard_qml() {
  local file key found limit base problems=0
  while IFS= read -r file; do
    key=".qmllintWarnings[\"$file\"]"
    found=$(qml_warnings "$file"); limit=$(allowed "$key"); base=$(allowed_on_main "$key" || true)
    if (( found > limit )); then echo "  $file: $found qmllint warnings, $limit allowed. Fix the new ones." >&2; problems=1
    elif (( found < limit )); then echo "  $file: $found qmllint warnings now. Lower qmllintWarnings to $found." >&2; problems=1
    fi
    if [[ -n $base ]] && (( limit > base )); then echo "  $file: qmllintWarnings went up. The allowlist only shrinks." >&2; problems=1; fi
  done < <(qml_files)
  return "$problems"
}

canary() {
  local missed=() big
  "${RUFF[@]}" canary/planted.py >/dev/null 2>&1 && missed+=("ruff")
  "$SHELLCHECK" canary/planted.sh >/dev/null 2>&1 && missed+=("shellcheck")
  strict_compile canary/planted.cpp >/dev/null 2>&1 && missed+=("warnings as errors")
  (( $(qml_warnings canary/planted.qml) > 0 )) || missed+=("qmllint")
  big=$(mktemp -d /tmp/mss-test-canary-XXXX)
  head -c $(( (MAX_TOKENS + 1) * 4 )) /dev/zero | tr '\0' x > "$big/oversize"
  # The size guard itself, on a file over the limit.
  size_problems <<< "$big/oversize" 2>/dev/null && missed+=("file size")
  rm -rf "$big"
  if (( ${#missed[@]} )); then fail canary "these went unnoticed: ${missed[*]}"; fi
  echo "Canary: all 5 planted violations caught."
}

build() {
  local out
  out=$(mktemp -d /tmp/mss-test-build-XXXX)
  qmake6 app/screensaver.pro -o "$out/Makefile" -after \
    "DESTDIR=$out" "OBJECTS_DIR=$out/obj" "MOC_DIR=$out/moc" "RCC_DIR=$out/rcc" \
    "QMAKE_CXXFLAGS+=${CXXFLAGS_STRICT[*]}" >/dev/null
  make -s -C "$out" -j"$(nproc)" >/dev/null || { rm -rf "$out"; return 1; }
  echo "Built $out/album-art-screensaver"
  rm -rf "$out"
}

main() {
  local shells pythons
  mapfile -t shells < <(shell_files); mapfile -t pythons < <(python_files)
  step shellcheck; "$SHELLCHECK" "${shells[@]}" || fail shellcheck "see above"
  echo "${#shells[@]} shell scripts pass."
  step ruff; "${RUFF[@]}" "${pythons[@]}" || fail ruff "see above"
  step guards; { guard_sizes && guard_qml; } || fail guards "see above"
  echo "Guards pass."
  step canary; canary
  [[ ${1:-} == --static ]] && return 0
  step build; build || fail build "the compiler reported the warnings above"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
